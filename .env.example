# Salin menjadi .env lalu isi.
# Kata sandi untuk masuk ke aplikasi (wajib).
APP_PASSWORD=ganti-dengan-kata-sandi-panjang
# Kunci untuk mengenkripsi API key di database. Isi dengan string acak panjang dan simpan baik-baik:
# kalau hilang atau berubah, kunci API harus dimasukkan ulang di Pengaturan.
SECRETS_KEY=
# Port di host.
PORT=8787

# Image dari GitHub Container Registry (huruf kecil semua), contoh: ghcr.io/namaakun/evertwo-story:latest
# IMAGE=ghcr.io/namaakun/evertwo-story:latest
# PULL_POLICY=always
